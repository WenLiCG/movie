+func TestStrictOrigin(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	original := config.C
+	t.Cleanup(func() { config.C = original })
+	calls := 0
+	mime, disposition := "application/json", ""
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		w.Header().Set("Content-Type", mime)
+		w.Header().Set("Content-Disposition", disposition)
+		_, _ = w.Write([]byte("origin-body"))
+	}))
+	defer origin.Close()
+	config.C = &config.Config{Emby: &config.Emby{Host: origin.URL}}
+	engine := gin.New()
+	engine.Any("/*path", ProxyOrigin)
+	request := func(path string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		engine.ServeHTTP(w, httptest.NewRequest("GET", path, nil))
+		return w
+	}
+	for _, path := range []string{"/Videos/42/stream", "/emby/Videos/42/original.mkv", "/Videos/42/master.m3u8", "/Videos/42/new-route/0.ts", "/Audio/42/stream", "/Items/42/download", "/Sync/JobItems/42/file", "/LiveTv/LiveStreamFiles/42/stream.ts"} {
+		if w := request(path); w.Code != 403 || strings.Contains(w.Body.String(), "origin-body") {
+			t.Fatalf("origin media leaked %s: %d", path, w.Code)
+		}
+	}
+	if calls != 0 {
+		t.Fatalf("media request reached origin: %d", calls)
+	}
+	for _, mime = range []string{"video/mp4", "audio/mpeg", "application/octet-stream", "application/mp4", "application/x-matroska"} {
+		if w := request("/unknown-future-stream"); w.Code != 403 || w.Body.Len() != 0 {
+			t.Fatalf("unknown media MIME leaked %s: %d", mime, w.Code)
+		}
+	}
+	mime = "text/plain"
+	disposition = "attachment; filename=movie.mkv"
+	if w := request("/unknown-download"); w.Code != 403 {
+		t.Fatalf("attachment leaked: %d", w.Code)
+	}
+	disposition = ""
+	for _, tc := range []struct{ path, mime string }{{"/System/Info", "application/json"}, {"/web/index.html", "text/html"}, {"/Videos/42/x/Subtitles/0/0/Stream.vtt", "text/vtt"}, {"/list", "application/vnd.apple.mpegurl"}} {
+		mime = tc.mime
+		if w := request(tc.path); w.Code != 200 || w.Body.String() != "origin-body" {
+			t.Fatalf("control route blocked %s: %d", tc.path, w.Code)
+		}
+	}
+}
+
+func TestStrictPlaylistRedirectSameOrigin(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	original := config.C
+	t.Cleanup(func() { config.C = original })
+	sourceID := "0123456789abcdef0123456789abcdef"
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/Items/42/PlaybackInfo":
+			_ = json.NewEncoder(w).Encode(map[string]any{"MediaSources": []map[string]string{{"Id": sourceID, "Path": "/index/ali/Movie.mp4"}}})
+		case "/api/fs/other":
+			_, _ = w.Write([]byte(`{"code":200,"data":{"video_preview_play_info":{"live_transcoding_task_list":[{"template_id":"FHD","url":"https://cloud.example/master.m3u8"}]}}}`))
+		default:
+			w.WriteHeader(404)
+		}
+	}))
+	defer origin.Close()
+	config.C = &config.Config{Emby: &config.Emby{Host: origin.URL, MountPath: "/index", Strm: &config.Strm{}}, Path: &config.Path{}, Openlist: &config.Openlist{Host: origin.URL, Token: "test"}}
+	_ = config.C.Path.Init()
+	publicOrigin, _ := url.Parse("https://movie.example")
+	cases := []struct {
+		path    string
+		handler gin.HandlerFunc
+	}{
+		{"/videos/42/master.m3u8?template_id=FHD&openlist_path=/ali/Movie.mp4&api_key=session", Redirect2Transcode},
+		{"/videos/42/stream?api_key=session&MediaSourceId=" + url.QueryEscape(sourceID+"[[_]]FHD"), Redirect2OpenlistLink},
+	}
+	for _, tc := range cases {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		// TLS terminates at Caddy; the relay request is plain HTTP with untrusted forwarded headers.
+		c.Request = httptest.NewRequest("GET", "http://relay:8095"+tc.path, nil)
+		c.Request.Header.Set("X-Forwarded-Proto", "http")
+		c.Request.Header.Set("X-Forwarded-Host", "attacker.example")
+		c.Set("authorizedItemID", "42")
+		tc.handler(c)
+		u, err := url.Parse(w.Header().Get("Location"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if w.Code != http.StatusTemporaryRedirect || u.IsAbs() || u.Host != "" || u.Path != "/videos/proxy_playlist" || u.Query().Get("item_id") != "42" {
+			t.Fatalf("unsafe playlist redirect: status=%d location=%s", w.Code, u)
+		}
+		resolved := publicOrigin.ResolveReference(u)
+		if resolved.Scheme != "https" || resolved.Host != "movie.example" {
+			t.Fatalf("mixed content: %s", resolved)
+		}
+	}
