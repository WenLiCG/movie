+package web
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/AmbitiousJun/go-emby2openlist/v2/internal/config"
+	"github.com/AmbitiousJun/go-emby2openlist/v2/internal/service/emby"
+	"github.com/gin-gonic/gin"
+)
+
+func TestStrictWebAssets(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	original := config.C
+	t.Cleanup(func() { config.C = original })
+	mime, calls := "application/javascript", 0
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		w.Header().Set("Content-Type", mime)
+		_, _ = w.Write([]byte("asset-body"))
+	}))
+	defer origin.Close()
+	config.C = &config.Config{Emby: &config.Emby{Host: origin.URL}, Ge2o: &config.Ge2o{Web: &config.Web{Disable: true}}}
+	initRulePatterns()
+	router := gin.New()
+	router.Use(emby.ApiKeyChecker())
+	router.Any("/*path", globalDftHandler)
+	request := func(path string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest("GET", path, nil))
+		return w
+	}
+	for _, path := range []string{"/web/videos/videos.js?v=4.10.2.0", "/web/modules/audio/player.js", "/web/modules/websocket.js", "/emby/web/videos/videos.js", "/web/videos/proxy_ts.js?fake=/videos/proxy_ts"} {
+		if w := request(path); w.Code != 200 || w.Body.String() != "asset-body" {
+			t.Fatalf("static asset blocked or dispatched as media: %s: %d", path, w.Code)
+		}
+	}
+	before := calls
+	for _, path := range []string{"/Videos/42/stream", "/Audio/42/stream", "/web/../Videos/42/stream", "/web?fake=/videos/proxy_ts"} {
+		if w := request(path); w.Code != 401 {
+			t.Fatalf("unauthenticated media accepted: %s: %d", path, w.Code)
+		}
+	}
+	if calls != before {
+		t.Fatal("unauthenticated media reached origin")
+	}
+	mime = "video/mp4"
+	if w := request("/web/videos/stream.js"); w.Code != 403 || w.Body.Len() != 0 {
+		t.Fatal("static namespace bypassed the media response guard")
+	}
+}
