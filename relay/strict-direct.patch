+	}
+	return strings.Contains(p, "/videos/") || strings.Contains(p, "/audio/") ||
+		strings.Contains(p, "/livetv/") || strings.HasSuffix(p, "/download") ||
+		(strings.Contains(p, "/sync/jobitems/") && strings.HasSuffix(p, "/file"))
+}
 
