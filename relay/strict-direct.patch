+func TestStrictAuthorization(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	original := config.C
+	t.Cleanup(func() { config.C = original })
+	status := 200
+	errorCode, itemID, calls := "", "42", 0
+	invalidJSON, empty := false, false
+	alternate := false
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Header.Get("X-Emby-Token") != "session" {
+			w.WriteHeader(401)
+			return
+		}
+		if r.URL.Path != "/Items/42/PlaybackInfo" || r.URL.Query().Get("AutoOpenLiveStream") != "false" {
+			w.WriteHeader(404)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(status)
+		if invalidJSON {
+			_, _ = w.Write([]byte("{"))
+			return
+		}
+		sources := []map[string]string{{"ItemId": itemID, "Path": "/index/ali/Movie.mp4"}}
+		if alternate {
+			sources = append(sources, map[string]string{"ItemId": "99", "Path": "/index/ali/Alternate.mp4"})
+		}
+		if empty {
+			sources = nil
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"ErrorCode": errorCode, "MediaSources": sources})
+	}))
+	defer origin.Close()
+	config.C = &config.Config{Emby: &config.Emby{Host: origin.URL, MountPath: "/index"}, Path: &config.Path{}}
+	_ = config.C.Path.Init()
+	engine := gin.New()
+	engine.Use(ApiKeyChecker())
+	engine.Any("/*path", func(c *gin.Context) { c.Status(204) })
+	request := func(path, token string) int {
+		r := httptest.NewRequest("GET", path, nil)
+		if token != "" {
+			r.Header.Set("X-Emby-Token", token)
+		}
+		w := httptest.NewRecorder()
+		engine.ServeHTTP(w, r)
+		return w.Code
+	}
+	if got := request("/Videos/42/stream", ""); got != 401 {
+		t.Fatalf("missing token: %d", got)
+	}
+	if calls != 0 {
+		t.Fatal("missing tokens should not reach origin")
+	}
+	if got := request("/Videos/42/stream", "session"); got != 204 {
+		t.Fatalf("valid: %d", got)
+	}
+	status = 401
+	if got := request("/Videos/42/stream", "session"); got != 401 {
+		t.Fatalf("revoked token was cached: %d", got)
+	}
+	status = 403
+	if got := request("/Videos/42/stream", "session"); got != 403 {
+		t.Fatalf("403 accepted: %d", got)
+	}
+	status = 500
+	if got := request("/Videos/42/stream", "session"); got != 502 {
+		t.Fatalf("500 accepted: %d", got)
+	}
+	status = 200
+	errorCode = "NotAllowed"
+	if got := request("/Videos/42/stream", "session"); got != 403 {
+		t.Fatalf("playback not allowed: %d", got)
+	}
+	errorCode = ""
+	empty = true
+	if got := request("/Videos/42/stream", "session"); got != 403 {
+		t.Fatalf("empty sources accepted: %d", got)
+	}
+	empty = false
+	invalidJSON = true
+	if got := request("/Videos/42/stream", "session"); got != 502 {
+		t.Fatalf("invalid json: %d", got)
+	}
+	invalidJSON = false
+	status = 403
+	if got := request("/Videos/42/stream", "session"); got != 403 {
+		t.Fatalf("hidden item: %d", got)
+	}
+	status = 200
+	itemID = "99"
+	if got := request("/Videos/42/stream", "session"); got != 403 {
+		t.Fatalf("wrong item: %d", got)
+	}
+
+	itemID = "42"
+	alternate = true
+	for _, path := range []string{"/Items/42/PlaybackInfo", "/Videos/42/stream?MediaSourceId=mediasource_99", "/videos/proxy_ts?item_id=42&openlist_path=/ali/Alternate.mp4"} {
+		if got := request(path, "session"); got != 204 {
+			t.Fatalf("Emby-linked version rejected %s: %d", path, got)
+		}
+	}
+	if got := request("/videos/proxy_ts?item_id=42&openlist_path=/ali/Private.mp4", "session"); got != 403 {
+		t.Fatalf("unrelated path accepted in a version group: %d", got)
+	}
+	alternate = false
+	if got := request("/web?fake=/videos/proxy_ts&item_id=42&openlist_path=/ali/Movie.mp4", "session"); got != 403 {
+		t.Fatalf("query-injected media route: %d", got)
+	}
+	if got := request("/prefix/videos/proxy_ts?item_id=42&openlist_path=/ali/Private.mp4", "session"); got != 403 {
+		t.Fatalf("prefixed media route: %d", got)
+	}
+	for _, endpoint := range []string{"proxy_playlist", "proxy_ts", "proxy_subtitle"} {
+		path := "/videos/" + endpoint + "?item_id=42&openlist_path=" + url.QueryEscape(openlist.PathEncode("/ali/Movie.mp4"))
+		if got := request(path, "session"); got != 204 {
+			t.Fatalf("authorized %s: %d", endpoint, got)
+		}
+		if got := request(strings.Replace(path, "item_id=42&", "", 1), "session"); got != 403 {
+			t.Fatalf("missing item %s: %d", endpoint, got)
+		}
+		path = "/videos/" + endpoint + "?item_id=42&openlist_path=" + url.QueryEscape(openlist.PathEncode("/ali/Private.mp4"))
+		if got := request(path, "session"); got != 403 {
+			t.Fatalf("forged path %s: %d", endpoint, got)
+		}
+	}
+	forged := "origin[[_]]FHD[[_]]1920x1080[[_]]" + openlist.PathEncode("/ali/Private.mp4")
+	if got := request("/videos/42/stream?MediaSourceId="+url.QueryEscape(forged), "session"); got != 403 {
+		t.Fatalf("forged media source: %d", got)
+	}
+	if got := request("/Users/AuthenticateByName", ""); got != 204 {
+		t.Fatalf("login route blocked: %d", got)
+	}
+}
