+func authorizationJSON(ctx context.Context, uri, token string, result any) int {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, strings.TrimRight(config.C.Emby.Host, "/")+uri, nil)
+	if err != nil {
+		return http.StatusBadGateway
+	}
+	req.Header.Set(QueryTokenName, token)
+	req.Header.Set("Accept", "application/json")
+	resp, err := authorizationClient.Do(req)
+	if err != nil {
+		return http.StatusBadGateway
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		if resp.StatusCode == http.StatusUnauthorized {
+			return http.StatusUnauthorized
+		}
+		if resp.StatusCode == http.StatusForbidden || resp.StatusCode == http.StatusNotFound {
+			return http.StatusForbidden
+		}
+		return http.StatusBadGateway
+	}
+	if !strings.HasPrefix(strings.ToLower(resp.Header.Get("Content-Type")), "application/json") {
+		return http.StatusBadGateway
+	}
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 2<<20)).Decode(result); err != nil {
+		return http.StatusBadGateway
 	}
+	return http.StatusOK
 }
 
