+func blocksOriginResponse(h http.Header) bool {
+	ct := strings.ToLower(strings.TrimSpace(strings.Split(h.Get("Content-Type"), ";")[0]))
+	disposition := strings.ToLower(h.Get("Content-Disposition"))
+	if strings.Contains(disposition, "attachment") {
+		return true
+	}
+	if ct == "application/vnd.apple.mpegurl" || ct == "application/x-mpegurl" || ct == "audio/x-mpegurl" {
+		return false
 	}
+	return strings.HasPrefix(ct, "video/") || strings.HasPrefix(ct, "audio/") ||
+		ct == "application/octet-stream" || ct == "application/mp4" || ct == "application/ogg" ||
+		ct == "application/x-matroska"
 }
 
