+		}
+		u, err := url.Parse(line)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if u.Query().Get("item_id") != "42" || u.Query().Get("api_key") != "session" || u.Path != "/videos/proxy_ts" {
+			t.Fatalf("segment lost item binding: %s", line)
+		}
+		count++
+	}
+	if count != 2 {
+		t.Fatalf("segment count %d", count)
+	}
+}
+
+func TestStrictPlaylistSegmentsSameOrigin(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	original := GetPlaylist
+	t.Cleanup(func() { GetPlaylist = original })
+	info, err := NewByContent("https://cloud.example/", strings.NewReader("#EXTM3U\n#EXTINF:6,\n0.ts\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	GetPlaylist = func(cloudPath, template string, proxy, main bool, prefix, token, itemID string) (string, bool) {
+		if prefix != "/videos" {
+			t.Errorf("playlist embeds relay origin: %s", prefix)
+		}
+		return info.ProxyContent(main, prefix, token, itemID), true
+	}
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest("GET", "http://relay:8095/videos/proxy_playlist?openlist_path=/ali/Movie.mp4&template_id=FHD&api_key=session&item_id=42", nil)
+	c.Request.Header.Set("X-Forwarded-Proto", "http")
+	c.Request.Header.Set("X-Forwarded-Host", "attacker.example")
+	ProxyPlaylist(c)
+	publicOrigin, _ := url.Parse("https://movie.example")
+	if w.Code != 200 {
+		t.Fatalf("playlist status %d", w.Code)
+	}
+	count := 0
+	for _, line := range strings.Split(w.Body.String(), "\n") {
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		u, err := url.Parse(line)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resolved := publicOrigin.ResolveReference(u)
+		if u.IsAbs() || u.Host != "" || resolved.Scheme != "https" || resolved.Host != "movie.example" {
+			t.Fatalf("unsafe segment URL: %s", line)
+		}
+		count++
+	}
+	if count != 1 {
+		t.Fatalf("segment count %d", count)
+	}
+}
