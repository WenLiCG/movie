@@ -0,0 +1,19 @@
+package openlist
+
+import (
+    "testing"
+    "github.com/AmbitiousJun/go-emby2openlist/v2/internal/config"
+)
+
+func TestStrictFetchRejectsMissingConfig(t *testing.T) {
+    original := config.C
+    defer func() { config.C = original }()
+    config.C = nil
+    if err := Fetch("/api/fs/list", "POST", nil, nil, nil, false); err == nil {
+        t.Fatal("missing configuration must return an error")
+    }
+    config.C = &config.Config{}
+    if err := Fetch("/api/fs/list", "POST", nil, nil, nil, false); err == nil {
+        t.Fatal("missing OpenList configuration must return an error")
+    }
+}
