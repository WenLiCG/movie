 // Fetch 请求 openlist api, 响应封装在 v 指针指向的结构中
 func Fetch(uri, method string, header http.Header, body map[string]any, v any, closeConn bool) error {
+	if config.C == nil || config.C.Openlist == nil {
+		return fmt.Errorf("openlist is not configured")
+	}
 	host := config.C.Openlist.Host
 	token := config.C.Openlist.Token
+	// The portal rotates this private file without restarting playback sessions.
+	if data, err := os.ReadFile("/app/cinema-config/openlist-token"); err == nil {
+		token = strings.TrimSpace(string(data))
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("cannot read managed OpenList token")
+	}
 	if strs.AnyEmpty(host, token) {
 		return fmt.Errorf("openlist.host 或 openlist.token 配置为空")
 	}
