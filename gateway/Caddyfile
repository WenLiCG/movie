(cinema_admin) {
    forward_auth portal:8097 {
        uri /discover/api/admin-check
    }
}

{$MOVIE_DOMAIN} {
    encode zstd gzip
    header >Referrer-Policy "no-referrer"
    header >Cache-Control "private, no-store"
    redir /search /search/ 308
    redir /discover /discover/ 308
    redir /sonarr /sonarr/ 308
    redir /qb /qb/ 308
    redir /openlist /openlist/ 308
    handle /discover/* {
        reverse_proxy portal:8097
    }
    handle /search/* {
        import cinema_admin
        reverse_proxy prowlarr:9696 {
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /sonarr/* {
        import cinema_admin
        reverse_proxy sonarr:8989 {
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /openlist/* {
        import cinema_admin
        reverse_proxy openlist:5244
    }
    handle_path /qb/* {
        import cinema_admin
        reverse_proxy qbittorrent:8080
    }
    # Management stays on the SSH-tunnelled port, including the relay's web UI.
    @management {
        path /ge2o /ge2o/*
        not path /ge2o/custom.js /ge2o/custom.css
    }
    handle @management {
        respond "Not found" 404
    }
    handle {
        reverse_proxy relay:8095
    }
    handle_errors {
        header Cache-Control "private, no-store"
        header Referrer-Policy "no-referrer"
    }
}

# Public movie-wall / playback site on MOVIE3_DOMAIN (for example movie3.example.com).
# Replaces the earlier EMBY_DOMAIN site. This site is not covered by Cloudflare Access.
# Management UIs stay on {$MOVIE_DOMAIN}. Requests are filtered by path and method:
# an admin token does not grant extra APIs here. movie3 does not issue or accept
# the portal cinema Cookie; /discover/api management endpoints are gateway 403.
#
# Shared Emby-wall rules, imported twice (under handle_path /movie/* after the
# prefix is stripped, and at the domain root for /emby, /mediabrowser and
# /embywebsocket). Matcher and regexp names are suffixed with {args[0]} so the
# two imports do not collide.
(emby_wall) {
    # WebSocket is allowed only on /embywebsocket (optional /emby or
    # /mediabrowser prefix, after /movie is stripped). Any other Upgrade is 403.
    @emby_ws_{args[0]} {
        method GET HEAD
        path_regexp emby_ws_{args[0]} (?i)^(/emby|/mediabrowser)?/embywebsocket/?$
    }
    handle @emby_ws_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
        }
    }
    @websocket_{args[0]} {
        expression "{http.request.header.Upgrade}.matches('(?i)websocket')"
    }
    handle @websocket_{args[0]} {
        respond "Forbidden" 403
    }

    @blocked_pages_{args[0]} {
        path_regexp blocked_pages_{args[0]} (?i)^(/emby|/mediabrowser)?/((discover|search|sonarr|qb|ge2o|openlist)(/.*)?|web/(dashboard|configurationpage).*)
    }
    handle @blocked_pages_{args[0]} {
        respond "Not found" 404
    }

    @versioned_public_req_{args[0]} {
        method GET HEAD
        path_regexp verpub_{args[0]} (?i)^(/emby|/mediabrowser)?/web/.+\.(js|css|woff2?|ttf|otf|map|png|svg|ico|webp|jpe?g|gif)$
        expression "{http.request.uri.query}.matches('(?i)(^|&)(v|version)=') && {http.request.header.Cookie} == '' && {http.request.header.Authorization} == '' && {http.request.header.X-Emby-Token} == '' && !{http.request.uri.query}.matches('(?i)(^|&)(api_key|X-Emby-Token)=')"
    }
    handle @versioned_public_req_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            @ok_static_{args[0]} status 200 304
            handle_response @ok_static_{args[0]} {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges Etag Last-Modified Content-Encoding
                }
                copy_response
                header Cache-Control "public, max-age=31536000, immutable"
                header Vary "Accept-Encoding"
            }
            @err_static_{args[0]} status 4xx 5xx
            handle_response @err_static_{args[0]} {
                copy_response_headers {
                    include Content-Type Content-Length
                }
                copy_response
                header Cache-Control "private, no-store"
            }
            header_down Location "(?i)^https?://[^/]+/openlist/p/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^https?://[^/]+/openlist/d/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^/openlist/p/(.*)$" "/openlist/d/$1"
        }
    }

    @images_anon_req_{args[0]} {
        method GET HEAD
        path_regexp imganon_{args[0]} (?i)^(/emby|/mediabrowser)?/Items/[^/]+/Images
        expression "{http.request.header.Cookie} == '' && {http.request.header.Authorization} == '' && {http.request.header.X-Emby-Token} == '' && !{http.request.uri.query}.matches('(?i)(^|&)(api_key|X-Emby-Token)=')"
    }
    handle @images_anon_req_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            @ok_img_{args[0]} status 200 304
            handle_response @ok_img_{args[0]} {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges Etag Last-Modified Content-Encoding
                }
                copy_response
                header Cache-Control "private, max-age=300"
            }
            @err_img_{args[0]} status 4xx 5xx
            handle_response @err_img_{args[0]} {
                copy_response_headers {
                    include Content-Type Content-Length
                }
                copy_response
                header Cache-Control "private, no-store"
            }
        }
    }

    @allowed_post_{args[0]} {
        method POST
        path_regexp allow_post_{args[0]} (?i)^(/emby|/mediabrowser)?/(Users/AuthenticateByName/?$|Items/[A-Za-z0-9._-]+/PlaybackInfo/?$|Sessions/Playing(/Progress|/Stopped|/Ping)?/?$|Sessions/Capabilities(/Full)?/?$)
    }
    handle @allowed_post_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
        }
    }

    @reserved_item_ops_{args[0]} {
        path_regexp reserved_{args[0]} (?i)^(/emby|/mediabrowser)?/Items/Delete(/.*)?$
    }
    handle @reserved_item_ops_{args[0]} {
        respond "Forbidden" 403
    }

    @allowed_get_{args[0]} {
        method GET HEAD
        path_regexp allow_get_{args[0]} (?i)^(/emby|/mediabrowser)?/(Users/Me/?$|Users/Me/(Items|Views|HomeSections|Sections)(/.*)?$|Users/([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$|Users/([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/(Items|Views|HomeSections|Sections)(/.*)?$|Items/[A-Za-z0-9._-]+/?$|Items/[A-Za-z0-9._-]+/Images(/.*)?$|Items/[A-Za-z0-9._-]+/PlaybackInfo/?$|Videos/[A-Za-z0-9._-]+/(stream(\.[A-Za-z0-9]+)?|master\.m3u8|hls[0-9]+/.*|Subtitles/.*)$|Audio/[A-Za-z0-9._-]+/stream.*$|Users/Public/?$|UserSettings/([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$|Items/[A-Za-z0-9._-]+/(Similar|ThemeMedia)/?$|System/Info/Public/?$|System/Endpoint/?$|System/Ping/?$|Branding(/.*)?$|Shows/[A-Za-z0-9._-]+(/(Episodes|Seasons|NextUp))?/?$|web/?$|web/.*$)
    }
    handle @allowed_get_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
            # QA D6: rewrite Location and drop the upstream HTML body,
            # which still contains https://movie2…/openlist/p/…. Movie2 site is
            # unchanged. Any leftover absolute Location is reduced to a path.
            @emby_redir_{args[0]} status 300 301 302 303 307 308
            handle_response @emby_redir_{args[0]} {
                header Cache-Control "private, no-store"
                header Referrer-Policy "no-referrer"
                header Location "{http.reverse_proxy.header.Location}"
                header Location "(?i)^https?://[^/]+/openlist/p/(.*)$" "/openlist/d/$1"
                header Location "(?i)^https?://[^/]+/openlist/d/(.*)$" "/openlist/d/$1"
                header Location "(?i)^/openlist/p/(.*)$" "/openlist/d/$1"
                header Location "(?i)^https?://[^/]+(/.*)$" "$1"
                header Content-Length 0
                header -Content-Type
                respond "" {http.reverse_proxy.status_code}
            }
        }
    }

    # Complete /System/Info (not /Public) requires a non-empty token at the gateway.
    # Empty Token= / api_key= is unauthenticated: 403 and do not proxy.
    # A non-empty token value is forwarded; the gateway does not validate sessions.
    @system_info_authed_{args[0]} {
        method GET HEAD
        path_regexp system_info_full_{args[0]} (?i)^(/emby|/mediabrowser)?/System/Info/?$
        expression "{http.request.header.X-Emby-Token} != '' || {http.request.header.X-Emby-Authorization}.matches('(?i)Token=\"?[^,& \"]+\"?') || {http.request.header.Authorization}.matches('(?i)Token=\"?[^,& \"]+\"?') || {http.request.uri.query}.matches('(?i)(^|&)(api_key|X-Emby-Token)=[^&]+')"
    }
    handle @system_info_authed_{args[0]} {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
            @emby_redir_info_{args[0]} status 300 301 302 303 307 308
            handle_response @emby_redir_info_{args[0]} {
                header Cache-Control "private, no-store"
                header Referrer-Policy "no-referrer"
                header Location "{http.reverse_proxy.header.Location}"
                header Location "(?i)^https?://[^/]+/openlist/p/(.*)$" "/openlist/d/$1"
                header Location "(?i)^https?://[^/]+/openlist/d/(.*)$" "/openlist/d/$1"
                header Location "(?i)^/openlist/p/(.*)$" "/openlist/d/$1"
                header Location "(?i)^https?://[^/]+(/.*)$" "$1"
                header Content-Length 0
                header -Content-Type
                respond "" {http.reverse_proxy.status_code}
            }
        }
    }

    handle {
        respond "Forbidden" 403
    }
}

{$MOVIE3_DOMAIN} {
    encode zstd gzip
    header >Referrer-Policy "no-referrer"
    header Cache-Control "private, no-store"
    header >Vary "Authorization, Cookie, X-Emby-Token"

    # movie3 neither accepts nor issues the portal cinema Cookie.
    request_header Cookie "(?i)(^|;\s*)cinema=[^;]*" ""
    request_header Cookie "(?i)^;\s*" ""
    header >Set-Cookie "(?i)^cinema=.*" ""

    # Defense in depth: reject raw request-targets whose path (before '?')
    # contains encoded slashes/dots/backslashes, a literal %25 (double or
    # multiple encoding, e.g. %252e), semicolons, or '//' .
    # Caddy's path matcher decodes %2F/%2e and cleans '..' before matching;
    # rejecting these encodings on the raw URI closes bypasses and avoids
    # sending ambiguous targets to relay. Ordinary clients use literal slashes.
    # This matcher looks at {http.request.uri} (the original URI) and is
    # evaluated before handle_path strips /movie.
    @dangerous {
        expression "{http.request.uri}.matches('(?i)^[^?]*((%2f)|(%2e)|(%5c)|(%25)|;|//)')"
    }
    handle @dangerous {
        respond "Forbidden" 403
    }

    @root path /
    handle @root {
        header Location "/movie/"
        header Content-Length 0
        respond "" 302
    }

    @movie_exact path /movie
    handle @movie_exact {
        header Location "/movie/"
        header Content-Length 0
        respond "" 308
    }

    # Emby HTML/JS emits root-absolute /web/…; bounce those back under /movie.
    # No response-body rewriting (no replace_response / sub_filter).
    @web_at_root {
        path /web /web/*
    }
    handle @web_at_root {
        header Location "/movie{http.request.uri}"
        header Content-Length 0
        respond "" 308
    }

    @discover_slash path /discover
    handle @discover_slash {
        header Location "/discover/"
        header Content-Length 0
        respond "" 308
    }

    # Every /discover/api path is a management endpoint (see portal/server.py
    # and docs/SETUP.md). Gateway 403; the request never reaches portal.
    @discover_api {
        path_regexp discover_api (?i)^/discover/api(/.*)?$
    }
    handle @discover_api {
        respond "Forbidden" 403
    }

    handle /discover/* {
        # Matching uses the cleaned path, but reverse_proxy would otherwise
        # forward the raw request-target (e.g. /movie/../discover/) and the
        # real portal would 404. Collapse literal '..' so the upstream URI
        # equals a direct /discover/ request. Encoded '%2e' is rejected
        # earlier on the raw URI. Not a response-body rewrite.
        uri path_regexp ^(?:/.*)?/\.\./discover(.*)$ /discover$1
        reverse_proxy portal:8097 {
            header_up Cookie "(?i)(^|;\s*)cinema=[^;]*" ""
            header_up Cookie "(?i)^;\s*" ""
            header_down Set-Cookie "(?i)^cinema=.*" ""
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
        }
    }

    # /search, /sonarr, /qb, /ge2o stay on MOVIE_DOMAIN. /openlist management
    # pages are 404; signed GET/HEAD /openlist/d/… is allowed below.
    @blocked_mgmt {
        path_regexp blocked_mgmt (?i)^/(search|sonarr|qb|ge2o)(/.*)?$
    }
    handle @blocked_mgmt {
        respond "Not found" 404
    }

    @openlist_ui {
        path /openlist /openlist/ /openlist/*
        not path /openlist/d /openlist/d/*
    }
    handle @openlist_ui {
        respond "Not found" 404
    }

    # Signed OpenList direct links for public playback, at the domain root.
    # GET/HEAD only, sign required, Range passed through, always no-store.
    # OpenList 401 (bad or reused sign) is surfaced as a gateway 403.
    @openlist_direct {
        method GET HEAD
        path_regexp ol_direct (?i)^/openlist/d/.+
        expression "{http.request.uri.query}.matches('(?i)(^|&)sign=[^&]+')"
    }
    handle @openlist_direct {
        reverse_proxy openlist:5244 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
            @ol_unauth status 401 403
            handle_response @ol_unauth {
                header Cache-Control "private, no-store"
                header Referrer-Policy "no-referrer"
                respond "Forbidden" 403
            }
            @ol_err status 4xx 5xx
            handle_response @ol_err {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges
                }
                copy_response
                header Cache-Control "private, no-store"
            }
        }
    }

    # Browser entry: strip /movie, then apply the same wall rules used at
    # /emby on the domain root. /movie/ (empty remainder) goes to the web UI.
    handle_path /movie/* {
        @movie_subroot path /
        handle @movie_subroot {
            header Location "/movie/web/index.html"
            header Content-Length 0
            respond "" 302
        }
        import emby_wall movie
    }

    # Official apps and Emby Web root-absolute /emby/… and /embywebsocket.
    @emby_client {
        path /emby /emby/* /mediabrowser /mediabrowser/* /embywebsocket /embywebsocket/*
    }
    handle @emby_client {
        import emby_wall embyroot
    }

    handle {
        respond "Forbidden" 403
    }

    handle_errors {
        header Cache-Control "private, no-store"
        header Referrer-Policy "no-referrer"
    }
}
