(cinema_admin) {
    forward_auth portal:8097 {
        uri /discover/api/admin-check
    }
}

{$MOVIE_DOMAIN} {
    encode zstd gzip
    header >Referrer-Policy "no-referrer"
    header >Cache-Control "private, no-store"
    redir /search /search/ 308
    redir /discover /discover/ 308
    redir /sonarr /sonarr/ 308
    redir /qb /qb/ 308
    redir /openlist /openlist/ 308
    handle /discover/* {
        reverse_proxy portal:8097
    }
    handle /search/* {
        import cinema_admin
        reverse_proxy prowlarr:9696 {
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /sonarr/* {
        import cinema_admin
        reverse_proxy sonarr:8989 {
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /openlist/* {
        import cinema_admin
        reverse_proxy openlist:5244
    }
    handle_path /qb/* {
        import cinema_admin
        reverse_proxy qbittorrent:8080
    }
    # Management stays on the SSH-tunnelled port, including the relay's web UI.
    @management {
        path /ge2o /ge2o/*
        not path /ge2o/custom.js /ge2o/custom.css
    }
    handle @management {
        respond "Not found" 404
    }
    handle {
        reverse_proxy relay:8095
    }
    handle_errors {
        header Cache-Control "private, no-store"
        header Referrer-Policy "no-referrer"
    }
}

# Public movie-wall / playback site. Set EMBY_DOMAIN (for example emby.example.com).
# This site is not covered by Cloudflare Access. Management stays on {$MOVIE_DOMAIN}.
# Requests are filtered by path and method: an admin token does not grant extra APIs here.
{$EMBY_DOMAIN} {
    encode zstd gzip
    header >Referrer-Policy "no-referrer"
    header Cache-Control "private, no-store"
    header >Vary "Authorization, Cookie, X-Emby-Token"

    # Defense in depth: reject raw request-targets whose path (before '?')
    # contains encoded slashes/dots/backslashes, a literal %25 (double or
    # multiple encoding), semicolons, or '//' .
    # Caddy's path matcher decodes %2F/%2e and cleans '..' before matching;
    # rejecting these encodings on the raw URI closes bypasses and avoids
    # sending ambiguous targets to relay. Ordinary clients use literal slashes.
    @dangerous {
        expression "{http.request.uri}.matches('(?i)^[^?]*((%2f)|(%2e)|(%5c)|(%25)|;|//)')"
    }
    handle @dangerous {
        respond "Forbidden" 403
    }

    # Management UIs and the sibling apps stay on MOVIE_DOMAIN. /openlist is
    # no longer a blanket 404: signed GET/HEAD /openlist/d/… is allowed below,
    # every other /openlist path is 403 (see @openlist_direct / fallback).
    # Hash routes such as /web/index.html#!/dashboard cannot be blocked by
    # path; the API whitelist below is the real control.
    @blocked_pages {
        path_regexp blocked_pages (?i)^(/emby|/mediabrowser)?/((discover|search|sonarr|qb|ge2o)(/.*)?|web/(dashboard|configurationpage).*)
    }
    handle @blocked_pages {
        respond "Not found" 404
    }

    # WebSocket is denied by default (MV-11 will confirm whether the official
    # Emby App needs /embywebsocket). Any Upgrade: websocket is also denied.
    @websocket {
        expression "{http.request.header.Upgrade}.matches('(?i)websocket') || {http.request.uri.path}.matches('(?i)(^|/)embywebsocket')"
    }
    handle @websocket {
        respond "Forbidden" 403
    }

    @root path /
    handle @root {
        redir * /web/index.html 302
    }

    # Signed OpenList direct links for public playback. GET/HEAD only, sign
    # required, Range passed through, always no-store. OpenList 401 (bad or
    # reused sign) is surfaced as a gateway 403. Pages, /api, /p, and the
    # root fall through to the 403 handler.
    @openlist_direct {
        method GET HEAD
        path_regexp ol_direct (?i)^/openlist/d/.+
        expression "{http.request.uri.query}.matches('(?i)(^|&)sign=[^&]+')"
    }
    handle @openlist_direct {
        reverse_proxy openlist:5244 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
            @ol_unauth status 401 403
            handle_response @ol_unauth {
                header Cache-Control "private, no-store"
                header Referrer-Policy "no-referrer"
                respond "Forbidden" 403
            }
            @ol_err status 4xx 5xx
            handle_response @ol_err {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges
                }
                copy_response
                header Cache-Control "private, no-store"
            }
        }
    }

    # Public cache only for successful (2xx/304) versioned /web/ static
    # assets with no credentials. Gateway 403/404 and upstream 4xx/5xx keep
    # the site-level private, no-store (this handle never runs for 403s
    # generated by earlier handlers).
    @versioned_public_req {
        method GET HEAD
        path_regexp verpub (?i)^(/emby|/mediabrowser)?/web/.+\.(js|css|woff2?|ttf|otf|map|png|svg|ico|webp|jpe?g|gif)$
        expression "{http.request.uri.query}.matches('(?i)(^|&)(v|version)=') && {http.request.header.Cookie} == '' && {http.request.header.Authorization} == '' && {http.request.header.X-Emby-Token} == '' && !{http.request.uri.query}.matches('(?i)(^|&)(api_key|X-Emby-Token)=')"
    }
    handle @versioned_public_req {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            @ok_static status 200 304
            handle_response @ok_static {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges Etag Last-Modified Content-Encoding
                }
                copy_response
                header Cache-Control "public, max-age=31536000, immutable"
                header Vary "Accept-Encoding"
            }
            @err_static status 4xx 5xx
            handle_response @err_static {
                copy_response_headers {
                    include Content-Type Content-Length
                }
                copy_response
                header Cache-Control "private, no-store"
            }
            header_down Location "(?i)^https?://[^/]+/openlist/p/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^https?://[^/]+/openlist/d/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^/openlist/p/(.*)$" "/openlist/d/$1"
        }
    }

    # Anonymous item images may use a short private cache only on 2xx/304;
    # any token or Cookie, and any 4xx/5xx, stay no-store.
    @images_anon_req {
        method GET HEAD
        path_regexp imganon (?i)^(/emby|/mediabrowser)?/Items/[^/]+/Images
        expression "{http.request.header.Cookie} == '' && {http.request.header.Authorization} == '' && {http.request.header.X-Emby-Token} == '' && !{http.request.uri.query}.matches('(?i)(^|&)(api_key|X-Emby-Token)=')"
    }
    handle @images_anon_req {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            @ok_img status 200 304
            handle_response @ok_img {
                copy_response_headers {
                    include Content-Type Content-Length Content-Range Accept-Ranges Etag Last-Modified Content-Encoding
                }
                copy_response
                header Cache-Control "private, max-age=300"
            }
            @err_img status 4xx 5xx
            handle_response @err_img {
                copy_response_headers {
                    include Content-Type Content-Length
                }
                copy_response
                header Cache-Control "private, no-store"
            }
        }
    }

    # POST whitelist: only playback-essential write endpoints, each backed
    # by an mv4viewer observation (AuthenticateByName login, PlaybackInfo,
    # Sessions/Playing*). Other POST/PUT/PATCH/DELETE is 403.
    @allowed_post {
        method POST
        path_regexp allow_post (?i)^(/emby|/mediabrowser)?/(Users/AuthenticateByName/?$|Items/[A-Za-z0-9._-]+/PlaybackInfo/?$|Sessions/Playing(/Progress|/Stopped|/Ping)?/?$)
    }
    handle @allowed_post {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
        }
    }

    # "Delete" matches the item-id character class; reject it by name first.
    @reserved_item_ops {
        path_regexp reserved (?i)^(/emby|/mediabrowser)?/Items/Delete(/.*)?$
    }
    handle @reserved_item_ops {
        respond "Forbidden" 403
    }

    # GET/HEAD whitelist. User ids are Emby GUIDs (32 hex or hyphenated UUID).
    # /Users, /Users/New, /Users/Public and /Users/{id}/Policy are not listed.
    # Videos are limited to stream / HLS / subtitles (not /Delete).
    @allowed_get {
        method GET HEAD
        path_regexp allow_get (?i)^(/emby|/mediabrowser)?/(Users/Me/?$|Users/Me/(Items|Views)(/.*)?$|Users/([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$|Users/([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/(Items|Views)(/.*)?$|Items/[A-Za-z0-9._-]+/?$|Items/[A-Za-z0-9._-]+/Images(/.*)?$|Items/[A-Za-z0-9._-]+/PlaybackInfo/?$|Videos/[A-Za-z0-9._-]+/(stream(\.[A-Za-z0-9]+)?|master\.m3u8|hls[0-9]+/.*|Subtitles/.*)$|Audio/[A-Za-z0-9._-]+/stream.*$|System/Info/Public/?$|System/Ping/?$|Shows/[A-Za-z0-9._-]+(/(Episodes|Seasons|NextUp))?/?$|web/?$|web/.*$)
    }
    handle @allowed_get {
        reverse_proxy relay:8095 {
            header_down -Cache-Control
            header_down Cache-Control "private, no-store"
            header_down Location "(?i)^https?://[^/]+/openlist/p/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^https?://[^/]+/openlist/d/(.*)$" "/openlist/d/$1"
            header_down Location "(?i)^/openlist/p/(.*)$" "/openlist/d/$1"
        }
    }

    handle {
        respond "Forbidden" 403
    }

    handle_errors {
        header Cache-Control "private, no-store"
        header Referrer-Policy "no-referrer"
    }
}
