(cinema_admin) {
    forward_auth portal:8097 {
        uri /discover/api/admin-check
        header_up Cookie "cinema={http.request.cookie.cinema}"
        header_up -Authorization
    }
}

(without_portal_cookie) {
    header_up Cookie "(?:^|(;)\s*)(?:cinema=[^;]*(?:;\s*|$))+" "$1"
}

{$MOVIE_DOMAIN} {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        # HTTPS-only site; no includeSubDomains or preload so other hosts on the domain are unaffected.
        Strict-Transport-Security "max-age=31536000"
    }
    redir /search /search/ 308
    redir /discover /discover/ 308
    redir /sonarr /sonarr/ 308
    redir /qb /qb/ 308
    redir /openlist /openlist/ 308
    handle /discover/* {
        reverse_proxy portal:8097
    }
    handle /search/* {
        import cinema_admin
        reverse_proxy prowlarr:9696 {
            import without_portal_cookie
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /sonarr/* {
        import cinema_admin
        reverse_proxy sonarr:8989 {
            import without_portal_cookie
            header_down Location ^http://(.*)$ https://$1
            header_down Set-Cookie "^(.*)$" "$1; Secure"
        }
    }
    handle /openlist/* {
        import cinema_admin
        reverse_proxy openlist:5244 {
            import without_portal_cookie
        }
    }
    handle_path /qb/* {
        import cinema_admin
        reverse_proxy qbittorrent:8080 {
            import without_portal_cookie
        }
    }
    # Management stays on the SSH-tunnelled port, including the relay's web UI.
    @management {
        path /ge2o /ge2o/*
        not path /ge2o/custom.js /ge2o/custom.css
    }
    respond @management "Not found" 404
    handle {
        header X-Frame-Options "SAMEORIGIN"
        reverse_proxy relay:8095 {
            import without_portal_cookie
        }
    }
}

